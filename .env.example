# Twitch application (https://dev.twitch.tv/console). Its OAuth redirect URL must be PUBLIC_URL/auth/callback.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# The one public HTTPS address (for example a Cloudflare Tunnel). Streamer B's OBS loads /overlay/b from here.
PUBLIC_URL=http://localhost:3000
# Host channel login (community A) and, once you have a partner, their login (community B). B needs no sign-in.
CHANNEL_A=
CHANNEL_B=
# The account that reads and posts in both chats. Defaults to CHANNEL_A, so the host can be the bot.
BOT_LOGIN=
# Protects the control panel, /api, /auth and /metrics. Generate with: openssl rand -hex 24
ADMIN_TOKEN=
PORT=3000
# Set PUBLIC=1 only to listen on all interfaces (Docker sets it). Otherwise the server binds to 127.0.0.1.
PUBLIC=
COMMAND_PREFIX=!g
# Each community needs this many voters for a round to count, and this many distinct !hint requests (at least) to unlock its hint.
MIN_VOTERS_TO_WIN=2
HINT_THRESHOLD=3
# VIDEO_SAFE=1 deals only audited puzzles without game characters or brands.
VIDEO_SAFE=
# SANDBOX=1 runs the public try-it-now page instead of the Twitch server.
SANDBOX=
SANDBOX_MAX_GAMES=200
# TRUST_PROXY: how many proxies sit in front (1 behind a tunnel or a host proxy). Leave empty when none do.
TRUST_PROXY=
LOG_LEVEL=info
# Puzzle Forge and audit (not needed to run the game)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
AUDIT_MODELS=gemini:gemini-3.5-flash,gemini:gemini-2.5-flash,groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b
# Fact panel: a fact is rejected only when every model here says false.
FACT_MODELS=gemini:gemini-2.5-flash,groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b
# The forge keeps auditing across runs until this many puzzles pass within the category quotas.
FORGE_PASS_TARGET=60
AUDIT_BATCH=8
AUDIT_RPM_GEMINI=5
AUDIT_RPM_GROQ=4
AUDIT_RPM_OPENAI=10
GEMINI_API_KEY=
